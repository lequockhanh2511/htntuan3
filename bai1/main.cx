#define RCC_APB2ENR   (*(volatile unsigned long *)0x40021018)

#define GPIOA_CRH     (*(volatile unsigned long *)0x40010804)

#define USART1_SR     (*(volatile unsigned long *)0x40013800)
#define USART1_DR     (*(volatile unsigned long *)0x40013804)
#define USART1_BRR    (*(volatile unsigned long *)0x40013808)
#define USART1_CR1    (*(volatile unsigned long *)0x4001380C)

void delay(void)
{
    volatile unsigned long i;

    for (i = 0; i < 800000; i++)
    {
    }
}

void UART_Init(void)
{
    /*
     * Bật clock GPIOA
     * Bật clock USART1
     */
    RCC_APB2ENR |= (1 << 2);
    RCC_APB2ENR |= (1 << 14);

    /*
     * PA9 = USART1_TX
     * Alternate Function Push-Pull
     * 50 MHz
     */
    GPIOA_CRH &= ~(0xF << 4);
    GPIOA_CRH |=  (0xB << 4);

    /*
     * HSI = 8 MHz
     * Baudrate = 9600
     */
    USART1_BRR = 0x341;

    /*
     * UE = 1
     * TE = 1
     */
    USART1_CR1 |= (1 << 13);
    USART1_CR1 |= (1 << 3);
}

void UART_SendChar(char c)
{
    while (!(USART1_SR & (1 << 7)))
    {
    }

    USART1_DR = c;
}

void UART_SendString(char *str)
{
    while (*str)
    {
        UART_SendChar(*str);
        str++;
    }
}

int main(void)
{
    UART_Init();

    while (1)
    {
        UART_SendString("Hello STM32!\r\n");

        delay();
    }
}
